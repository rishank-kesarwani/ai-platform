# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
LOG_LEVEL=info

# Service Authentication (Service-to-Service API Keys comma-separated)
AI_SERVICE_API_KEY=test-service-api-key-12345

# MongoDB
MONGODB_URI=mongodb://root:rootpassword@localhost:27017/ai_platform?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_platform_documents

# Google Gemini LLM & Embeddings
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# RAG Configuration
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SCORE=0.5

# Semantic & AI Response Caching
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=300

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
